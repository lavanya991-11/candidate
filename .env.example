PORT=3000

# ---------------------------------------------------------------------------
# Pick ONE of the three setups below.
# With none of them filled in, the app still runs and writes to
# data/candidates.json, so the form is fully testable with no credentials.
# ---------------------------------------------------------------------------

# --- A) BC SaaS (online) - OAuth client credentials. Needs an app registration.
BC_AUTH_MODE=oauth
BC_DEPLOYMENT=cloud
BC_BASE_URL=https://api.businesscentral.dynamics.com
BC_TENANT_ID=<azure-ad-tenant-guid>
BC_ENVIRONMENT=Production
BC_COMPANY_ID=<company-guid>
BC_CLIENT_ID=<app-registration-client-id>
BC_CLIENT_SECRET=<app-registration-secret>

# --- B) BC on-premises - username + web service access key, NO client id/secret.
# BC_AUTH_MODE=basic
# BC_DEPLOYMENT=onprem
# BC_BASE_URL=https://bc-server:7048/BC190
# BC_COMPANY_ID=<company-guid>
# BC_USERNAME=<bc-user-name>
# BC_WEB_SERVICE_KEY=<web-service-access-key>

# --- C) No Business Central at all: leave the above unset (local JSON file).

# Must match APIPublisher / APIGroup / APIVersion on page 50102
BC_API_PUBLISHER=novasoft
BC_API_GROUP=recruitment
BC_API_VERSION=v1.0
